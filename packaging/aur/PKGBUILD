# Maintainer: jdkcube
pkgname=keepitnew
pkgver=0.1.3
pkgrel=1
pkgdesc='Arch, AUR and Flatpak update dashboard and disk cleanup'
arch=('any')
url='https://github.com/JudokaCube/keepitnew'
license=('MIT')
depends=('python>=3.11' 'kitty' 'systemd' 'pacman' 'fakeroot' 'sudo')
optdepends=('flatpak: optional Flatpak updates and cleanup' 'pacman-contrib: update checks and package-cache cleanup' 'yay: AUR updates' 'paru: alternative AUR helper' 'waybar: optional desktop bar' 'quickshell: optional Caelestia widget' 'qt6-declarative: optional Caelestia QML integration')
source=('keepitnew-0.1.3.tar.gz::https://github.com/JudokaCube/keepitnew/releases/download/v0.1.3/keepitnew-0.1.3.tar.gz')
sha256sums=('9f9ec7d7d57cb2aa182d0f835ade0e154b9598628f9e0736cb12bf93104f7d70')

check() {
    python - "$srcdir/$pkgname-$pkgver" <<'PY'
import ast,sys,subprocess,tempfile,os,json
from pathlib import Path
root=Path(sys.argv[1])
for path in root.rglob('*'):
    if path.is_file() and (path.suffix=='.py' or path.parent.name=='bin'):
        ast.parse(path.read_text())
with tempfile.TemporaryDirectory() as temp:
    env=dict(os.environ,HOME=temp,XDG_CONFIG_HOME=temp+'/config',XDG_DATA_HOME=temp+'/data',XDG_CACHE_HOME=temp+'/cache',XDG_STATE_HOME=temp+'/state',PYTHONDONTWRITEBYTECODE='1')
    command=[sys.executable,str(root/'bin/system-update')]
    version=subprocess.check_output(command+['--version'],env=env,text=True)
    assert '0.1.3' in version,version
    args=['status','--waybar'] if 'keepitnew'=='studentdaily' else ['--waybar']
    status=json.loads(subprocess.check_output(command+args,env=env,text=True))
    assert isinstance(status,dict) and 'text' in status
    subprocess.run([sys.executable,str(root/'setup.py'),'--help'],env=env,check=True,stdout=subprocess.DEVNULL)
PY
}

package() {
    local tree="$srcdir/$pkgname-$pkgver"
    install -Dm755 "$tree/bin/system-update" "$pkgdir/usr/lib/$pkgname/system-update"
    install -Dm644 "$tree/bin/keepitnew_ui.py" "$pkgdir/usr/lib/$pkgname/keepitnew_ui.py"
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/$pkgname" "$pkgdir/usr/lib/systemd/user"
    ln -s "/usr/lib/$pkgname/system-update" "$pkgdir/usr/bin/$pkgname"
    install -Dm755 "$tree/setup.py" "$pkgdir/usr/share/$pkgname/setup.py"
    install -Dm644 "$tree/configure.py" "$pkgdir/usr/share/$pkgname/configure.py"
    ln -s "/usr/share/$pkgname/setup.py" "$pkgdir/usr/bin/$pkgname-setup"
    cp -r "$tree/plugins" "$tree/integrations" "$pkgdir/usr/share/$pkgname/"
    local unit
    for unit in "$tree"/services/*; do
        sed 's|%h/.local/bin/system-update|/usr/bin/keepitnew|g' "$unit" > "$pkgdir/usr/lib/systemd/user/${unit##*/}"
        chmod 644 "$pkgdir/usr/lib/systemd/user/${unit##*/}"
    done
    install -Dm644 "$tree/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$tree/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$tree/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
}
